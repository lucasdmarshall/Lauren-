  "tags": [
    "dynamic",
    "smooth"
  ],
  "duration": {
    "default": 1,
    "min": 0.1
  },
  "params_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "amount": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.5,
        "description": "Blur length."
      }
    }
  }
}
