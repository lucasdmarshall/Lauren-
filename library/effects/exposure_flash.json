{
  "id": "exposure_flash",
  "kind": "effect",
  "name": "Exposure flash",
  "description": "Brief overexposed flash that decays quickly. Accents a beat, a hit or a camera-shutter moment.",
  "tags": [
    "impact",
    "energetic"
  ],
  "duration": {
    "default": 0.2,
    "min": 0.05,
    "max": 1
  },
  "params_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "intensity": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.8,
        "description": "Strength of the effect."
      },
      "color": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$",
        "default": "#ffffff",
        "description": "Flash color."
      }
    }
  }
}
