{
  "id": "flip",
  "kind": "transition",
  "name": "Card flip",
  "description": "The frame flips like a card to show the next clip on its back. Good for reveals and before/after.",
  "tags": [
    "3d",
    "reveal",
    "playful"
  ],
  "duration": {
    "default": 0.5,
    "min": 0.2,
    "max": 1.2
  },
  "overlap": true,
  "params_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "axis": {
        "enum": [
          "horizontal",
          "vertical"
        ],
        "default": "horizontal",
        "description": "Axis of the flip."
      }
    }
  }
}
