{
  "id": "circle_reveal",
  "kind": "transition",
  "name": "Circle reveal",
  "description": "The next clip appears inside a growing circle (iris). Spotlights a subject; place the center on what matters.",
  "tags": [
    "reveal",
    "playful"
  ],
  "duration": {
    "default": 0.5,
    "min": 0.2,
    "max": 1.5
  },
  "overlap": true,
  "params_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "x": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.5,
        "description": "Horizontal center (0 = left, 1 = right)."
      },
      "y": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.5,
        "description": "Vertical center (0 = top, 1 = bottom)."
      },
      "feather": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.1,
        "description": "Edge softness."
      }
    }
  }
}
