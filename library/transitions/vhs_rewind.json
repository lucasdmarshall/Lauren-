    "retro",
    "vintage",
    "comedic"
  ],
  "duration": {
    "default": 0.5,
    "min": 0.2,
    "max": 1.5
  },
  "params_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "noise": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.6,
        "description": "Amount of tape noise."
      }
    }
  }
}
