{
  "id": "glitch",
  "kind": "transition",
  "name": "Glitch",
  "description": "Digital corruption at the cut: blocks shift, colors split, frames jump. Edgy and techy; suits gaming, tech, music and fast montage.",
  "tags": [
    "edgy",
    "tech",
    "energetic"
  ],
  "duration": {
    "default": 0.3,
    "min": 0.1,
    "max": 1
  },
  "params_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "intensity": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.6,
        "description": "Strength of the effect."
      },
      "rgb_split": {
        "type": "boolean",
        "default": true,
        "description": "Separate the color channels during the glitch."
      }
    }
  }
}
