{
  "id": "mosaic",
  "kind": "transition",
  "name": "Mosaic",
  "description": "The frame breaks into tiles that turn to reveal the next clip. Graphic and polished; good for photo dumps and recaps.",
  "tags": [
    "graphic",
    "stylish"
  ],
  "duration": {
    "default": 0.6,
    "min": 0.25,
    "max": 1.5
  },
  "overlap": true,
  "params_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "tiles": {
        "type": "integer",
        "minimum": 2,
        "maximum": 20,
        "default": 6,
        "description": "Tiles along the shorter side."
      }
    }
  }
}
