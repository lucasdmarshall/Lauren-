{
  "id": "clock_wipe",
  "kind": "transition",
  "name": "Clock wipe",
  "description": "The next clip sweeps in like a clock hand. Implies time passing; good for before/after and countdowns.",
  "tags": [
    "time",
    "playful"
  ],
  "duration": {
    "default": 0.6,
    "min": 0.2,
    "max": 1.5
  },
  "overlap": true,
  "params_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "rotation": {
        "enum": [
          "clockwise",
          "counterclockwise"
        ],
        "default": "clockwise",
        "description": "Sweep direction."
      },
      "x": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.5,
        "description": "Horizontal center (0 = left, 1 = right)."
      },
      "y": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.5,
        "description": "Vertical center (0 = top, 1 = bottom)."
      }
    }
  }
}
