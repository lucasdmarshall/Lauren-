{
  "id": "blinds",
  "kind": "transition",
  "name": "Blinds",
  "description": "The frame splits into strips that flip or slide to reveal the next clip. Graphic and stylish; suits fashion and product shots.",
  "tags": [
    "graphic",
    "stylish"
  ],
  "duration": {
    "default": 0.5,
    "min": 0.2,
    "max": 1.2
  },
  "overlap": true,
  "params_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "strips": {
        "type": "integer",
        "minimum": 2,
        "maximum": 30,
        "default": 8,
        "description": "Number of strips."
      },
      "orientation": {
        "enum": [
          "vertical",
          "horizontal"
        ],
        "default": "vertical",
        "description": "Strip direction."
      }
    }
  }
}
