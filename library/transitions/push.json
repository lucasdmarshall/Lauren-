{
  "id": "push",
  "kind": "transition",
  "name": "Push",
  "description": "The next clip pushes the previous one out of frame, both moving together. Feels like turning a page; good for sequences and travel.",
  "tags": [
    "clean",
    "dynamic"
  ],
  "duration": {
    "default": 0.35,
    "min": 0.15,
    "max": 1
  },
  "overlap": true,
  "params_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "direction": {
        "enum": [
          "left",
          "right",
          "up",
          "down"
        ],
        "default": "left",
        "description": "Direction both clips move."
      }
    }
  }
}
