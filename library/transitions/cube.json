{
  "id": "cube",
  "kind": "transition",
  "name": "Cube",
  "description": "Both clips sit on faces of a rotating 3D cube. Slick and techy; good for switching between angles or products.",
  "tags": [
    "3d",
    "slick",
    "tech"
  ],
  "duration": {
    "default": 0.6,
    "min": 0.25,
    "max": 1.5
  },
  "overlap": true,
  "params_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "direction": {
        "enum": [
          "left",
          "right",
          "up",
          "down"
        ],
        "default": "left",
        "description": "Direction the cube turns."
      }
    }
  }
}
