{
  "id": "ripple",
  "kind": "transition",
  "name": "Ripple",
  "description": "Water ripples spread from a point while the clips crossfade. Dreamy, liquid; suits flashbacks and beach or water footage.",
  "tags": [
    "dreamy",
    "liquid"
  ],
  "duration": {
    "default": 0.8,
    "min": 0.3,
    "max": 2
  },
  "overlap": true,
  "params_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "x": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.5,
        "description": "Horizontal center (0 = left, 1 = right)."
      },
      "y": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.5,
        "description": "Vertical center (0 = top, 1 = bottom)."
      },
      "amplitude": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.5,
        "description": "Ripple height."
      }
    }
  }
}
