{
  "id": "wipe_in",
  "kind": "animation",
  "name": "Wipe in",
  "description": "Revealed by an edge sweeping across it.",
  "tags": [
    "clean"
  ],
  "duration": {
    "default": 0.4,
    "min": 0.1,
    "max": 1.5
  },
  "slots": [
    "in",
    "out"
  ],
  "params_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "direction": {
        "enum": [
          "left",
          "right",
          "up",
          "down"
        ],
        "default": "right",
        "description": "Direction of the reveal."
      },
      "softness": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.2,
        "description": "Edge softness."
      }
    }
  }
}
