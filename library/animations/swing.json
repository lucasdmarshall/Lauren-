{
  "id": "swing",
  "kind": "animation",
  "name": "Swing",
  "description": "Swings in from a pivot at the top like a hanging sign.",
  "tags": [
    "playful"
  ],
  "duration": {
    "default": 0.7,
    "min": 0.2,
    "max": 2
  },
  "slots": [
    "in",
    "out"
  ],
  "params_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "angle": {
        "type": "number",
        "minimum": 10,
        "maximum": 120,
        "default": 60,
        "description": "Starting swing angle in degrees."
      }
    }
  }
}
