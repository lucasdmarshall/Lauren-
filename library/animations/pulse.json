{
  "id": "pulse",
  "kind": "animation",
  "name": "Pulse",
  "description": "Rhythmically grows and shrinks a little. Can follow the music beat.",
  "tags": [
    "rhythmic",
    "music"
  ],
  "duration": {
    "default": 0.5,
    "min": 0.2,
    "max": 4
  },
  "slots": [
    "loop"
  ],
  "params_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "amount": {
        "type": "number",
        "minimum": 0.01,
        "maximum": 0.3,
        "default": 0.08,
        "description": "Size change per pulse."
      },
      "on_beats": {
        "type": "boolean",
        "default": true,
        "description": "Pulse on music beats instead of the duration period."
      }
    }
  }
}
