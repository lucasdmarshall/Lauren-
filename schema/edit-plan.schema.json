{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lauren.app/schema/edit-plan/0.1.json",
  "title": "Lauren Edit Plan",
  "description": "An edit produced by the AI (or by the user on the timeline). All times are in seconds; the render engine snaps them to the output frame grid. Times inside a clip are source times, so they stay attached to the content when speed or trims change the timeline. Effects, transitions and animations are not defined here: the plan references items in the library (library/) by id, and their parameters are checked against each item's manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "output",
    "assets",
    "clips"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "summary": {
      "type": "string",
      "description": "Short description of the edit, written by the AI for the user."
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "assets": {
      "type": "array",
      "description": "Media the plan can use, in the order the user uploaded it. The app fills this list; the AI only references ids.",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "clips": {
      "type": "array",
      "description": "Main video track. Clips play back to back in this order, which the AI chooses (it may differ from upload order and may reuse an asset). Timeline positions and lengths are derived from trims, speed, speed ramps, freezes and overlapping transitions, never stored.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/clip"
      }
    },
    "overlays": {
      "type": "array",
      "description": "Stickers and images placed above the main track.",
      "items": {
        "$ref": "#/$defs/overlay"
      }
    },
    "texts": {
      "type": "array",
      "description": "Text placed on the video: titles, hooks, labels, calls to action.",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "captions": {
      "type": "array",
      "description": "Spoken words shown in sync with a clip's audio. Each entry is one caption track for one clip.",
      "items": {
        "$ref": "#/$defs/caption"
      }
    },
    "audio": {
      "type": "array",
      "description": "Music and other audio placed under the main track.",
      "items": {
        "$ref": "#/$defs/audio"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$",
      "description": "Stable id, so follow-up prompts and the timeline can refer to an item."
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "unit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Normalized frame coordinate: 0 = left/top, 1 = right/bottom."
    },
    "note": {
      "type": "string",
      "description": "Why the AI made this choice. Shown in the UI and fed back on follow-up prompts."
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect_ratio",
        "resolution",
        "fps"
      ],
      "properties": {
        "aspect_ratio": {
          "enum": [
            "9:16",
            "16:9",
            "4:3",
            "1:1"
          ]
        },
        "resolution": {
          "enum": [
            "720p",
            "1080p",
            "4k"
          ],
          "description": "Size of the shorter side: 720, 1080 or 2160 pixels."
        },
        "fps": {
          "enum": [
            24,
            25,
            30,
            50,
            60
          ]
        },
        "background": {
          "enum": [
            "black",
            "blur"
          ],
          "default": "blur",
          "description": "What fills empty space when a clip is reframed with mode 'fit'."
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "video",
            "audio",
            "image",
            "sticker"
          ]
        },
        "src": {
          "type": "string",
          "description": "Local path or URL. Set by the app, never by the AI."
        },
        "duration": {
          "$ref": "#/$defs/seconds"
        },
        "label": {
          "type": "string",
          "description": "Human-readable name, e.g. the file name."
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Pixel width. With height, tells the AI the orientation for reframing."
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "has_audio": {
          "type": "boolean",
          "description": "Whether a video asset has an audio track."
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "description": "Capture time from file metadata, if known. Helps the AI order clips."
        }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset",
        "in",
        "out"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "asset": {
          "$ref": "#/$defs/id"
        },
        "in": {
          "$ref": "#/$defs/seconds",
          "description": "Start time in the source. For an image asset, use 0."
        },
        "out": {
          "$ref": "#/$defs/seconds",
          "description": "End time in the source. Must be greater than 'in'. For an image asset, this is how long it is shown."
        },
        "reverse": {
          "type": "boolean",
          "default": false,
          "description": "Play the clip backward, from 'out' to 'in'. Source times keep pointing at the same frames, and speed, ramps, freezes and effects still apply. The clip's own audio also plays backward; set volume to 0 to mute it."
        },
        "speed": {
          "$ref": "#/$defs/speed_value",
          "default": 1,
          "description": "Constant speed. Use only one of speed, speed_ramp and speed_preset."
        },
        "speed_ramp": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/ramp_point"
          },
          "description": "Speed that changes over the clip. Points are in source time, in increasing order. Before the first point the first speed applies; after the last, the last speed. Use only one of speed, speed_ramp and speed_preset."
        },
        "speed_preset": {
          "$ref": "#/$defs/speed_preset"
        },
        "freezes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/freeze"
          },
          "description": "Freeze frames inserted into the clip."
        },
        "preserve_pitch": {
          "type": "boolean",
          "default": true,
          "description": "Keep the clip's audio at its natural pitch when the speed changes."
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 1,
          "description": "Volume of the clip's own audio. 0 mutes it."
        },
        "reframe": {
          "$ref": "#/$defs/reframe"
        },
        "transform": {
          "type": "array",
          "description": "Keyframes for zoom and pan, anchored to source times.",
          "items": {
            "$ref": "#/$defs/keyframe"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "transition_in": {
          "$ref": "#/$defs/transition",
          "description": "Transition from the previous clip into this one. Ignored on the first clip."
        },
        "note": {
          "$ref": "#/$defs/note"
        }
      }
    },
    "reframe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "description": "How a source with a different aspect ratio fits the output.",
      "properties": {
        "mode": {
          "enum": [
            "fill",
            "fit"
          ],
          "description": "fill: crop to cover the frame. fit: show the whole source over the background."
        },
        "focus_x": {
          "$ref": "#/$defs/unit",
          "default": 0.5
        },
        "focus_y": {
          "$ref": "#/$defs/unit",
          "default": 0.5
        }
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at"
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/source_time"
        },
        "scale": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10,
          "default": 1
        },
        "x": {
          "$ref": "#/$defs/unit",
          "default": 0.5,
          "description": "Horizontal center of the zoom."
        },
        "y": {
          "$ref": "#/$defs/unit",
          "default": 0.5,
          "description": "Vertical center of the zoom."
        },
        "rotation": {
          "type": "number",
          "minimum": -360,
          "maximum": 360,
          "default": 0
        },
        "easing": {
          "enum": [
            "linear",
            "ease_in",
            "ease_out",
            "ease_in_out",
            "hold"
          ],
          "default": "ease_in_out"
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "description": "An effect from library/effects, applied to part of a clip.",
      "properties": {
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "at": {
          "$ref": "#/$defs/source_time",
          "description": "Where the effect starts. Default: the clip's 'in'."
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "How long it lasts on screen, in timeline seconds. Default: the item's default duration, or until the clip ends if it has none."
        },
        "params": {
          "$ref": "#/$defs/params"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "description": "A transition from library/transitions. It never uses media outside 'in'/'out'. Whether the two clips overlap (and the timeline gets shorter by 'duration') is set by the item's manifest.",
      "properties": {
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "duration": {
          "$ref": "#/$defs/seconds",
          "description": "Default and allowed range come from the item's manifest."
        },
        "beat_sync": {
          "type": "boolean",
          "default": false,
          "description": "Snap the cut to the nearest beat of the music."
        },
        "params": {
          "$ref": "#/$defs/params"
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset",
        "duration"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "asset": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "$ref": "#/$defs/seconds",
          "description": "Timeline time. Use either 'start' or 'anchor'."
        },
        "anchor": {
          "$ref": "#/$defs/anchor",
          "description": "Start at a moment in a clip. Use either 'start' or 'anchor'."
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Timeline seconds."
        },
        "x": {
          "$ref": "#/$defs/unit",
          "default": 0.5
        },
        "y": {
          "$ref": "#/$defs/unit",
          "default": 0.5
        },
        "scale": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1,
          "default": 0.25,
          "description": "Width as a fraction of the output width."
        },
        "rotation": {
          "type": "number",
          "minimum": -360,
          "maximum": 360,
          "default": 0
        },
        "animation_in": {
          "$ref": "#/$defs/animation",
          "description": "Omit for no animation."
        },
        "animation_out": {
          "$ref": "#/$defs/animation",
          "description": "Omit for no animation."
        },
        "animation_loop": {
          "$ref": "#/$defs/animation",
          "description": "Repeats while the overlay is visible, between its in and out animations. Omit for none."
        },
        "note": {
          "$ref": "#/$defs/note"
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "asset": {
          "$ref": "#/$defs/id"
        },
        "start": {
          "$ref": "#/$defs/seconds",
          "description": "Timeline time. Use either 'start' or 'anchor'. Default: 0."
        },
        "anchor": {
          "$ref": "#/$defs/anchor",
          "description": "Start at a moment in a clip. Use either 'start' or 'anchor'."
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Timeline seconds. Default: until the end of the timeline, so music adapts when the edit gets longer or shorter."
        },
        "source_in": {
          "$ref": "#/$defs/seconds",
          "default": 0,
          "description": "Where playback starts inside the track."
        },
        "loop": {
          "type": "boolean",
          "default": false,
          "description": "Repeat the track if it is shorter than its duration."
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 1
        },
        "fade_in": {
          "$ref": "#/$defs/seconds",
          "default": 0
        },
        "fade_out": {
          "$ref": "#/$defs/seconds",
          "default": 0
        },
        "duck": {
          "type": "boolean",
          "default": true,
          "description": "Lower this track automatically while someone speaks in the clips."
        },
        "note": {
          "$ref": "#/$defs/note"
        }
      }
    },
    "ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "description": "Id of a library item of the kind the slot expects."
    },
    "params": {
      "type": "object",
      "description": "Values for the library item's parameters. Checked against the item's params_schema; omitted parameters use the item's defaults."
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "description": "An in or out animation from library/animations.",
      "properties": {
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "duration": {
          "$ref": "#/$defs/seconds",
          "description": "Default and allowed range come from the item's manifest."
        },
        "params": {
          "$ref": "#/$defs/params"
        }
      }
    },
    "source_time": {
      "type": "number",
      "minimum": 0,
      "description": "Time in the clip's source media, between the clip's 'in' and 'out'. Stays attached to the content when timing changes."
    },
    "speed_value": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 16,
      "description": "Playback speed: 1 normal, 0.25 four times slower, 4 four times faster."
    },
    "ramp_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "speed"
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/source_time"
        },
        "speed": {
          "$ref": "#/$defs/speed_value"
        },
        "easing": {
          "enum": [
            "linear",
            "smooth",
            "hold"
          ],
          "default": "smooth",
          "description": "How speed changes from this point to the next. hold keeps this speed until the next point."
        }
      }
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "duration"
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/source_time",
          "description": "Frame to hold."
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10,
          "description": "How long the frame is held, in timeline seconds. Adds to the clip's length."
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clip",
        "at"
      ],
      "description": "Places an item at a moment in a clip's content instead of a fixed timeline time, so it follows that moment when timing changes.",
      "properties": {
        "clip": {
          "$ref": "#/$defs/id"
        },
        "at": {
          "$ref": "#/$defs/source_time"
        }
      }
    },
    "speed_preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "at"
      ],
      "description": "A speed ramp preset from library/ramps, placed at a moment in the clip.",
      "properties": {
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "at": {
          "$ref": "#/$defs/source_time",
          "description": "The moment the preset is built around, e.g. the landing of a jump."
        },
        "params": {
          "$ref": "#/$defs/params"
        }
      }
    },
    "style_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "description": "A text style from library/text_styles.",
      "properties": {
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "params": {
          "$ref": "#/$defs/params"
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "duration",
        "style"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "The text. Use \\n for a line break."
        },
        "start": {
          "$ref": "#/$defs/seconds",
          "description": "Timeline time. Use either 'start' or 'anchor'."
        },
        "anchor": {
          "$ref": "#/$defs/anchor",
          "description": "Start at a moment in a clip. Use either 'start' or 'anchor'."
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Timeline seconds."
        },
        "style": {
          "$ref": "#/$defs/style_ref"
        },
        "x": {
          "$ref": "#/$defs/unit",
          "default": 0.5
        },
        "y": {
          "$ref": "#/$defs/unit",
          "default": 0.5
        },
        "max_width": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1,
          "default": 0.85,
          "description": "Wrap width as a fraction of the output width."
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ],
          "default": "center"
        },
        "rotation": {
          "type": "number",
          "minimum": -360,
          "maximum": 360,
          "default": 0
        },
        "animation_in": {
          "$ref": "#/$defs/animation",
          "description": "Omit for no animation."
        },
        "animation_out": {
          "$ref": "#/$defs/animation",
          "description": "Omit for no animation."
        },
        "animation_loop": {
          "$ref": "#/$defs/animation",
          "description": "Repeats while the overlay is visible, between its in and out animations. Omit for none."
        },
        "note": {
          "$ref": "#/$defs/note"
        }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "at",
        "end"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "$ref": "#/$defs/source_time",
          "description": "When the word starts being spoken."
        },
        "end": {
          "$ref": "#/$defs/source_time",
          "description": "When the word ends."
        }
      }
    },
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "clip",
        "words",
        "style"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "clip": {
          "$ref": "#/$defs/id",
          "description": "The clip whose audio is captioned. Word times are source times in that clip, so captions follow speed changes and trims; words outside the clip's in/out are not shown."
        },
        "words": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/word"
          },
          "description": "Words in spoken order, from the transcript."
        },
        "style": {
          "$ref": "#/$defs/style_ref"
        },
        "max_words": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "default": 3,
          "description": "Most words shown at once. Fewer reads faster and feels more energetic."
        },
        "y": {
          "$ref": "#/$defs/unit",
          "default": 0.72
        },
        "max_width": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1,
          "default": 0.85
        },
        "animation_in": {
          "$ref": "#/$defs/animation",
          "description": "Plays each time a new group of words appears."
        },
        "note": {
          "$ref": "#/$defs/note"
        }
      }
    }
  }
}
