{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lauren.app/schema/library-item/0.1.json",
  "title": "Lauren Library Item",
  "description": "Manifest for one library item: effect, transition, animation, speed ramp preset or text style. The AI receives a catalog built from these manifests and picks items by id; nothing about individual items is hardcoded in the edit plan schema or the app.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "name",
    "description",
    "params_schema"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "kind": {
      "enum": [
        "effect",
        "transition",
        "animation",
        "ramp",
        "text_style"
      ]
    },
    "version": {
      "type": "string",
      "default": "1.0.0"
    },
    "name": {
      "type": "string",
      "description": "Display name in the UI."
    },
    "description": {
      "type": "string",
      "description": "What it looks like and when to use it. Written for the AI: this is how it chooses."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Mood and style hints, e.g. energetic, smooth, comedic, cinematic."
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default"
      ],
      "properties": {
        "default": {
          "type": "number",
          "minimum": 0
        },
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "overlap": {
      "type": "boolean",
      "default": false,
      "description": "Transitions only. true: both clips are visible at once, so they overlap by the duration and the timeline gets shorter. false: applied to the end of the previous clip and the start of the next, timeline length unchanged."
    },
    "params_schema": {
      "type": "object",
      "description": "JSON Schema (type object) for the item's parameters. Every parameter needs a default and a description so the AI can use it."
    },
    "render": {
      "type": "object",
      "description": "How the engine draws the item. Format not decided yet (see docs/LIBRARY.md)."
    },
    "slots": {
      "type": "array",
      "items": {
        "enum": [
          "in",
          "out",
          "loop"
        ]
      },
      "minItems": 1,
      "uniqueItems": true,
      "default": [
        "in",
        "out"
      ],
      "description": "Animations only: which overlay slots the item can fill. 'in' plays as written; 'out' plays it in reverse; 'loop' repeats while the overlay is visible, with 'duration' as one cycle."
    },
    "points": {
      "type": "array",
      "minItems": 2,
      "description": "Ramps only: the speed ramp this preset expands to. Offsets are source seconds relative to the moment the preset is placed at. 'offset' and 'speed' are numbers or arithmetic expressions over the preset's parameters (e.g. \"-(before + ease)\").",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offset",
          "speed"
        ],
        "properties": {
          "offset": {
            "type": [
              "number",
              "string"
            ]
          },
          "speed": {
            "type": [
              "number",
              "string"
            ]
          },
          "easing": {
            "enum": [
              "linear",
              "smooth",
              "hold"
            ],
            "default": "smooth"
          }
        }
      }
    },
    "applies_to": {
      "type": "array",
      "items": {
        "enum": [
          "image",
          "text"
        ]
      },
      "minItems": 1,
      "uniqueItems": true,
      "default": [
        "image",
        "text"
      ],
      "description": "Animations only: whether the item works on image/sticker overlays, on text, or both."
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "description": "Text styles only: how text is drawn. The item's params override these keys, so every param name must be a style key.",
      "required": [
        "font",
        "size",
        "color"
      ],
      "properties": {
        "font": {
          "type": "string",
          "description": "Font family name. Fonts are bundled with the app (open-licensed)."
        },
        "weight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900,
          "default": 700
        },
        "size": {
          "type": "number",
          "minimum": 0.015,
          "maximum": 0.25,
          "description": "Cap height as a fraction of the output's shorter side."
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "uppercase": {
          "type": "boolean",
          "default": false
        },
        "letter_spacing": {
          "type": "number",
          "minimum": -0.1,
          "maximum": 0.5,
          "default": 0,
          "description": "Extra spacing as a fraction of the font size."
        },
        "line_height": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 2,
          "default": 1.15
        },
        "stroke_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "stroke_width": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3,
          "default": 0,
          "description": "Outline width as a fraction of the font size."
        },
        "shadow": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Drop shadow strength."
        },
        "glow_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "glow": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Glow strength."
        },
        "background_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "background_opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "background_radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.3,
          "description": "Corner radius as a fraction of the line height."
        },
        "highlight_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "highlight_mode": {
          "enum": [
            "none",
            "color",
            "box",
            "scale"
          ],
          "default": "none",
          "description": "Captions only: how the word being spoken is marked."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ramp"
          }
        }
      },
      "then": {
        "required": [
          "points"
        ]
      },
      "else": {
        "not": {
          "required": [
            "points"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "text_style"
          }
        }
      },
      "then": {
        "required": [
          "style"
        ]
      },
      "else": {
        "not": {
          "required": [
            "style"
          ]
        }
      }
    }
  ]
}
